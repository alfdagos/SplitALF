# =============================================================================
# SplitALF — variabili d'ambiente
# =============================================================================
# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase.
# Le trovi su: Supabase Dashboard -> Project Settings -> API
#
# IMPORTANTE: solo le variabili con prefisso VITE_ vengono esposte al frontend.
# La "anon key" è pubblica per design (l'accesso ai dati è protetto da RLS).
# NON inserire mai qui la "service_role key".
# =============================================================================

# URL del progetto Supabase (es. https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chiave pubblica "anon" del progetto Supabase
VITE_SUPABASE_ANON_KEY=your-anon-public-key
